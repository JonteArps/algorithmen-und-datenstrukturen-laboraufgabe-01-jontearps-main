package de.hs_flensburg.ads;

public class ArrayList<T> {

    int size = 0;

    Object[] elemente = new Object[10];


    public ArrayList(int capacity) {

        elemente = new Object[capacity];

    }

    public ArrayList() {

        elemente = new Object[10];

    }


    public boolean isEmpty() {

        if (size == 0) {
            return true;
        } else {
            return false;
        }
    }

    public int size() {
        return size;

    }

    @SuppressWarnings("unchecked")
    public T get(int index) {

        return (T) elemente[index];
    }


    public void add(int index, T element) {

        if (size == elemente.length) {
            elemente = Arrays.extendedCopyOf(elemente);
        }
        Arrays.shiftRight(elemente, index, size - 1);
        elemente[index] = element;
        size++;


    }

}
